DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Adventureworks
DB_USER=postgres
DB_PASSWORD=postgres
# Fecha de referencia de todos los analisis. Este dump de AdventureWorks tiene datos
# 2022-2025, asi que 2014-06-30 (el valor del ejemplo original) dejaria las ventanas vacias.
ANALYSIS_AS_OF_DATE=2025-06-29
# Limite de peticiones para /api/agent/* (ScopedRateThrottle).
AGENT_THROTTLE_RATE=120/min
# Retencion de agent_tool_log; purge_tool_logs borra lo mas antiguo.
AGENT_TOOL_LOG_RETENTION_DAYS=180
# Superusuario creado/actualizado por `manage.py ensure_superuser` (idempotente).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ADMIN12345
DJANGO_SUPERUSER_EMAIL=admin@example.com